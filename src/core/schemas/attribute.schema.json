 {
   "$schema": "http://json-schema.org/draft-07/schema#",
   "$id": "https://dissg.io/schemas/v1/attribute.json",
   "title": "Attribute",
   "description": "A property of an entity. Base object type 2 of 6.",
   "type": "object",
   "required": [
     "id",
     "type",
     "entity_id",
     "attribute_key",
     "value",
     "created_at",
     "valid_from",
     "source_id",
     "schema_version"
   ],
   "additionalProperties": false,
   "properties": {
     "id": {
       "type": "string",
       "format": "uuid",
       "description": "Global, eternal, immutable identifier (UUIDv7)"
     },
     "type": {
       "type": "string",
       "const": "ATTRIBUTE",
       "description": "Base object type discriminator"
     },
     "entity_id": {
       "type": "string",
       "format": "uuid",
       "description": "Reference to the ENTITY this attribute belongs to"
     },
     "attribute_key": {
       "type": "string",
       "minLength": 1,
       "maxLength": 100,
       "pattern": "^[a-z][a-z0-9_]*$",
       "description": "Machine-readable attribute identifier (snake_case)"
     },
     "attribute_definition_id": {
       "type": "string",
       "format": "uuid",
       "description": "Reference to formal attribute definition in ontology"
     },
     "value": {
       "description": "The actual attribute value (type varies)",
       "oneOf": [
         { "type": "string" },
         { "type": "number" },
         { "type": "boolean" },
         { "type": "array" },
         { "type": "object" }
       ]
     },
     "value_type": {
       "type": "string",
       "enum": ["string", "number", "boolean", "array", "object"],
       "description": "Explicit type declaration for value"
     },
     "unit": {
       "type": ["string", "null"],
       "description": "Unit of measurement (null if not applicable)"
     },
     "unit_system": {
       "type": "string",
       "enum": ["SI", "imperial", "custom"],
       "default": "SI",
       "description": "Unit measurement system"
     },
     "precision": {
       "type": ["integer", "null"],
       "minimum": 0,
       "maximum": 15,
       "description": "Decimal precision for numeric values"
     },
     "created_at": {
       "type": "string",
       "format": "date-time",
       "description": "UTC timestamp when record was created in system"
     },
     "valid_from": {
       "type": "string",
       "format": "date-time",
       "description": "When this attribute value became valid"
     },
     "valid_to": {
       "type": ["string", "null"],
       "format": "date-time",
       "description": "When this attribute value ceased to be valid"
     },
     "source_id": {
       "type": "string",
       "format": "uuid",
       "description": "Reference to SOURCE object"
     },
     "schema_version": {
       "type": "string",
       "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
     }
   }
 }